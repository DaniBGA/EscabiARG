# Copiá este archivo a .env.local y completá con los datos de tu proyecto
# Supabase -> Project Settings -> API (o "Connect")
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# Mostrar "Continuar con Google" (requiere habilitar el proveedor Google en Supabase)
VITE_ENABLE_GOOGLE_AUTH=false

# Botón "Probar sin cuenta" (modo demo con datos locales). Poné false para ocultarlo.
VITE_ENABLE_DEMO=false
